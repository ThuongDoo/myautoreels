# Cổng web
PORT=3000
# 127.0.0.1 = chỉ máy này truy cập. Trên VPS đặt 0.0.0.0 và BẮT BUỘC đặt APP_PASSWORD
HOST=127.0.0.1
# Mật khẩu đăng nhập web (user nhập gì cũng được, chỉ kiểm tra mật khẩu)
APP_PASSWORD=
# 1 = tắt đăng bài và tự cập nhật số liệu (dùng khi chạy bản copy data của VPS trên máy khác)
# DISABLE_WORKER=1
# Dùng cho `npm run pull-data`: chép database từ VPS về máy này (cần DISABLE_WORKER=1)
# VPS_SSH=root@1.2.3.4
# VPS_APP_DIR=/opt/autoreels
# Thư mục chứa database + cache video (mặc định ./data)
# DATA_DIR=
